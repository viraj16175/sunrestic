<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Google Play does not allow QUERY_ALL_PACKAGES for backup apps, so the app asks to see only what it needs:
      apps that have a launcher icon (the ones a person would back up), and VPN apps (they are never stopped).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.net.VpnService" />
        </intent>
    </queries>

</manifest>
