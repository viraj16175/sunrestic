# Copy this file to keystore.properties (it is ignored by git) and fill in your own release key.
# Create a key once with:
#   keytool -genkeypair -v -keystore sunrestic-release.jks -alias sunrestic -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks file and its passwords somewhere safe and backed up: every future update must be signed with the same key.
storeFile=sunrestic-release.jks
storePassword=
keyAlias=sunrestic
keyPassword=
